{
  "name": "zellij-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Zellij terminal workspace management",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "test:integration": "npm run build && node test-windows-mcp.js",
    "test:real-hardware": "npm run build && node --test --test-concurrency=1 \"test/real-hardware/*.test.js\""
  },
  "keywords": ["mcp", "zellij", "terminal", "workspace"],
  "author": "Jordan",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}