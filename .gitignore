# Dependencies
node_modules/

# Python (SAWEng demo-runner uses uv script-headers, which manage ephemeral
# envs themselves — no committed venv; this covers any local dev venv)
.venv/
__pycache__/

# Local reference clones (e.g. the Windows-MCP shallow clone) — reference only
third_party/

# Local runtime artifacts produced by the Windows-MCP integration
*.log
*.pid

# OS / editor noise
.DS_Store
